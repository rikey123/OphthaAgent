# ============================================
# CoT数据生成器配置文件
# 复制此文件为 .env 并填入您的实际配置
# ============================================

# ============================================
# 默认模型配置（推荐方式）
# 如果命令行未指定，将使用这些配置
# ============================================
MODEL_NAME=gpt-4o
API_KEY=your-api-key-here
BASE_URL=https://api.openai.com/v1

# ============================================
# 各平台API密钥（可选，用于预设模型）
# ============================================
# OpenAI API密钥 (用于GPT系列模型)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API密钥 (用于Claude系列模型，如果使用OpenAI兼容接口)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DashScope API密钥 (用于Qwen系列模型)
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# ============================================
# 使用示例
# ============================================
# 方式1：使用默认配置（最简单）
# 只需设置 MODEL_NAME, API_KEY, BASE_URL
# 然后运行: python cot_generator.py --dataset data.jsonl --output results.json

# 方式2：使用预设模型
# 设置对应的API密钥（如OPENAI_API_KEY），然后指定模型名
# 运行: python cot_generator.py --dataset data.jsonl --output results.json --model gpt-4o

# 方式3：命令行覆盖
# 即使.env中有配置，命令行参数也会优先
# 运行: python cot_generator.py --dataset data.jsonl --output results.json --model custom-model --base-url https://api.example.com/v1

