# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===== 模型配置 =====
# 模型名称（预设: gpt-4o, gpt-4, claude-3.5-sonnet, qwen-plus, qwen-max）
MODEL_NAME=gpt-4o

# API密钥
API_KEY=your-api-key-here

# API基础URL（可选，默认根据模型自动选择）
BASE_URL=https://api.openai.com/v1

# ===== 特定API密钥（如需使用多个提供商）=====
# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# 阿里云DashScope (Qwen)
DASHSCOPE_API_KEY=sk-...

# ===== 生成器配置 =====
# 最大并发数
MAX_WORKERS=3

# 是否启用工具缓存
ENABLE_CACHE=true

# 缓存目录
CACHE_DIR=./tool_cache

# ===== 工具路径 =====
# tools_interface.py所在目录
TOOLS_INTERFACE_PATH=../agents/fundus_tools_agent

# ===== 日志配置 =====
# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# 日志文件
LOG_FILE=cot_generator_v2.log

# ===== SSH远程图片获取配置 =====
# SSH服务器地址
SSH_HOST=your-server.com

# SSH用户名
SSH_USER=username

# SSH密码（可选，用于密码认证）
# 注意：密码认证需要安装 paramiko: pip install paramiko
SSH_PASSWORD=your-password

# SSH端口
SSH_PORT=22

# SSH密钥路径（可选，优先使用密钥认证）
# 如果设置了密钥路径，将忽略密码
SSH_KEY_PATH=/path/to/id_rsa

# 远程数据集根目录
REMOTE_BASE_PATH=<ANON_ABS_PATH>

# 本地图片缓存目录
LOCAL_CACHE_DIR=./image_cache

# 是否使用SCP（否则使用rsync）
# 密码认证时会自动使用SFTP
USE_SCP=true

